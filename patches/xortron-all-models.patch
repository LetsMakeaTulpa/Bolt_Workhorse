+def _matches_xortron(item: dict[str, Any]) -> bool:
+    for key in ("id", "name"):
+        if "xortron" in str(item.get(key, "")).casefold():
+            return True
+    return False
+
+
+def _rank_models(items: list[dict[str, Any]], preferred: str, agent: str) -> list[dict[str, Any]]:
+    order = {preferred: 0, agent: 1}
+    return sorted(items, key=lambda item: (order.get(str(item.get("id")), 2), str(item.get("id", "")).casefold()))
+
+
