{
  "name": "workhorse",
  "version": "1.0.0",
  "description": "AI chat platform with web search - Kimi + Venice inspired, powered by Featherless.ai",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:preview": "bash scripts/dev-preview.sh",
    "keys:import": "node scripts/import-keys.mjs keys.txt",
    "keys:apply": "node scripts/import-keys.mjs keys.txt --apply",
    "keys:paste": "node scripts/import-keys.mjs --stdin",
    "smoke": "bash scripts/smoke.sh",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "engines:verify": "node scripts/verify-engines.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
